{
  "name": "@nifrajs/ui",
  "version": "0.1.0",
  "description": "Source-owned, StyleX-powered UI components for humans and coding agents.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/tokens.stylex.d.ts",
      "import": "./dist/tokens/tokens.stylex.js"
    },
    "./styles.css": "./dist/tokens/global.css"
  },
  "peerDependencies": {
    "@stylexjs/stylex": ">=0.19.0",
    "react": ">=18.3.0",
    "react-dom": ">=18.3.0"
  },
  "devDependencies": {
    "@stylexjs/stylex": "^0.19.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
