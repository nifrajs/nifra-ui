{
  "name": "@nifrajs/ui-vue",
  "version": "0.1.0-alpha.1",
  "description": "Vue 3 adapter for the cross-framework Nifra UI core.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nifrajs/nifra-ui.git",
    "directory": "packages/ui-vue"
  },
  "bugs": "https://github.com/nifrajs/nifra-ui/issues",
  "homepage": "https://ui.nifra.dev",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun run ../../scripts/copy-adapter-assets.ts packages/ui-vue"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "dependencies": {
    "@nifrajs/ui-adapters": "^0.1.0-alpha.1",
    "@nifrajs/ui-elements": "^0.1.0-alpha.1"
  },
  "peerDependencies": {
    "vue": ">=3.4.0"
  }
}
