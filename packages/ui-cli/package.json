{
  "name": "@nifrajs/ui-cli",
  "version": "0.1.0-alpha.1",
  "description": "Source installer and contract inspector for Nifra UI.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nifrajs/nifra-ui.git",
    "directory": "packages/ui-cli"
  },
  "bugs": "https://github.com/nifrajs/nifra-ui/issues",
  "homepage": "https://ui.nifra.dev",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.js --target bun --format esm"
  },
  "bin": {
    "nifra-ui": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@nifrajs/ui-registry": "^0.1.0-alpha.1"
  }
}
