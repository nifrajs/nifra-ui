{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui.nifra.dev/schemas/component.schema.json",
  "type": "object",
  "required": [
    "name",
    "category",
    "description",
    "status",
    "sourceFiles",
    "exportName",
    "states",
    "accessibility",
    "agentNotes",
    "kind",
    "installCommand",
    "importCode",
    "usageCode",
    "dependencies",
    "variants",
    "targets",
    "previewStatus",
    "docs"
  ],
  "properties": {
    "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
    "category": {
      "enum": [
        "foundation",
        "action",
        "form",
        "navigation",
        "overlay",
        "feedback",
        "data",
        "agent"
      ]
    },
    "description": { "type": "string", "minLength": 1 },
    "status": { "enum": ["implemented", "planned"] },
    "sourceFiles": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "exportName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
    "states": { "type": "array", "items": { "type": "string" } },
    "accessibility": { "type": "array", "items": { "type": "string" } },
    "agentNotes": { "type": "array", "items": { "type": "string" } },
    "kind": { "enum": ["standard", "foundation", "agent", "recipe"] },
    "installCommand": { "type": "string", "minLength": 1 },
    "importCode": { "type": "string", "minLength": 1 },
    "usageCode": { "type": "string", "minLength": 1 },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "variants": { "type": "array", "items": { "type": "string" } },
    "targets": {
      "type": "object",
      "required": ["react", "vue", "svelte", "solid", "web-components"],
      "properties": {
        "react": { "enum": ["reference", "planned"] },
        "vue": { "enum": ["reference", "alpha", "planned"] },
        "svelte": { "enum": ["reference", "alpha", "planned"] },
        "solid": { "enum": ["reference", "alpha", "planned"] },
        "web-components": { "enum": ["reference", "alpha", "planned"] }
      },
      "additionalProperties": false
    },
    "previewStatus": { "const": "live" },
    "docs": {
      "type": "object",
      "required": ["install", "usageNotes", "examples"],
      "properties": {
        "install": {
          "type": "object",
          "required": ["command", "manual"],
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "manual": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "usageNotes": { "type": "string", "minLength": 1 },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["title", "description", "code"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "code": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
