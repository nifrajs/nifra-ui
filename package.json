{
  "name": "nifra-ui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite --config apps/docs/vite.config.ts",
    "build": "bun run build:packages && vite build --config apps/docs/vite.config.ts",
    "build:packages": "bun run build:ui && bun run build:registry && bun run build:cli && bun run build:mcp",
    "build:ui": "tsc -p packages/ui/tsconfig.build.json && bun run scripts/copy-ui-assets.ts",
    "build:registry": "tsc -p packages/ui-registry/tsconfig.build.json",
    "build:cli": "bun build packages/ui-cli/src/index.ts --outfile packages/ui-cli/dist/index.js --target bun --format esm",
    "build:mcp": "bun build packages/ui-mcp/src/index.ts --outfile packages/ui-mcp/dist/index.js --target bun --format esm",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run lint && bun run registry:check && bun run typecheck && bun run test && bun run build",
    "registry:check": "bun run packages/ui-registry/src/check.ts",
    "registry:generate": "bun run packages/ui-registry/src/generate.ts"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/generator": "^7.28.3",
    "@babel/parser": "^7.28.4",
    "@babel/plugin-syntax-flow": "^7.27.1",
    "@babel/plugin-syntax-jsx": "^7.27.1",
    "@babel/plugin-syntax-typescript": "^7.27.1",
    "@biomejs/biome": "^2.4.16",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/stylex": "^0.19.0",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8"
  }
}
