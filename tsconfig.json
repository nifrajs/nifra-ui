{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "types": ["vite/client", "bun"],
    "baseUrl": ".",
    "paths": {
      "@nifrajs/ui": ["packages/ui/src/index.ts"],
      "@nifrajs/ui-registry": ["packages/ui-registry/src/index.ts"]
    }
  },
  "include": ["packages", "apps", "tests"]
}
